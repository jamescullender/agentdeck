# Set these in Vercel → Project → Settings → Environment Variables.

# Claude API key from https://platform.claude.com
ANTHROPIC_API_KEY=sk-ant-...

# RevenueCat SECRET key (v1), used to verify Pro subscriptions server-side
REVENUECAT_SECRET_KEY=sk_...
REVENUECAT_ENTITLEMENT=pro

# Upstash Redis (free tier is fine), used for monthly run quotas.
# Without these, quotas are NOT enforced.
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=...

FREE_RUNS_PER_MONTH=20
PRO_RUNS_PER_MONTH=300
