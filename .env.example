# Copy to .env and fill in. These are bundled into the app, so no secrets here.

# Your deployed server (see server/). Leave empty to run in demo mode.
EXPO_PUBLIC_API_URL=https://agentdeck-server.vercel.app

# RevenueCat public SDK keys (Project settings → API keys)
EXPO_PUBLIC_RC_IOS_KEY=appl_xxxxxxxxxxxxxxxx
EXPO_PUBLIC_RC_ANDROID_KEY=goog_xxxxxxxxxxxxxxxx

EXPO_PUBLIC_PRIVACY_URL=https://www.bcmediaessex.co.uk/agentdeck/privacy
EXPO_PUBLIC_TERMS_URL=https://www.apple.com/legal/internet-services/itunes/dev/stdeula/
EXPO_PUBLIC_SUPPORT_EMAIL=hello@bcmediaessex.co.uk
